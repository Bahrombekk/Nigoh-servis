# Nigoh sozlamalari — .env nomi bilan nusxalang: cp .env.example .env
# Bu fayl (.env) gitga tushmaydi.

# Yagona kirish kaliti — MAJBURIY, busiz servis ishga tushmaydi.
# Tashqi backend har so'rovda `X-API-Key` sarlavhasi bilan yuboradi.
# Hosil qilish: openssl rand -hex 32
NIGOH_API_KEY=

# Birinchi ishga tushirishda yaratiladigan super-admin paroli (debug UI
# kirishi uchun). Berilmasa tasodifiy parol yaratiladi va konteyner
# logiga chiqadi (docker logs nigoh). Kamida 6 belgi.
ADMIN_PAROL=

# Super-admin logini (standart: admin)
#ADMIN_LOGIN=admin

# Sayt porti (standart: 8010)
#PORT=8010

# Debug UI (xarita + admin panel): 1 — yoqiq (standart, cookie login
# ishlaydi); 0 — faqat API, hamma narsa X-API-Key bilan.
#ENABLE_UI=1

# Brauzer video uchun ulanadigan manzil. Bo'sh qolsa so'rov manzilidan
# olinadi (odatda shu to'g'ri). Server NAT/proksi ortida bo'lsa tashqi
# IP yoki domenni yozing.
#MEDIA_HOST=

# Sayt HTTPS (nginx) ortida bo'lsa video ham HTTPS'dan yurishi shart —
# MEDIA_BASE oqim manzillarining asosi bo'ladi: {MEDIA_BASE}/hls/... va
# {MEDIA_BASE}/whep/... Nginx bu yo'llarni 8888/8889-portlarga o'tkazadi
# (namuna: docs/DEPLOY.md, HTTPS bo'limi).
#MEDIA_BASE=https://kamera.example.uz/media

# Telegram ogohlantirishlari (ixtiyoriy): kamera uzildi/qaytdi,
# oqim muzladi, MediaMTX qayta ishga tushdi.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# MediaMTX portlari (standartlari odatda yetarli)
#HLS_PORT=8888
#WEBRTC_PORT=8889
#MEDIAMTX_RTSP_PORT=8554
